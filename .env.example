# Jynx Relay & Gmail SMTP Configuration
# Copy this file to .env and fill in your Gmail credentials

# Server Port (Default: 8099)
PORT=8099

# Gmail SMTP Settings
# For Gmail, visit: https://myaccount.google.com/apppasswords
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password (Select App: Mail / Custom)
# 3. Paste your Gmail and the 16-character password below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=your-email@gmail.com

# Cloudflare R2 multipart uploads (required for transfers over 45 MB, up to 1 GB)
# Create an R2 API token with Object Read & Write permissions.
# Use the exact S3 API endpoint from Cloudflare R2 (no angle brackets or quotes).
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=jynx-payloads
